{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3ch-workers",
  "main": "src/main.js",
  "compatibility_date": "2025-09-19",
  "vars": {
    "ENVIRONMENT": "production",
    "salt": "ch35th_md5_SALT!2328959a823239020f%4M?67343883c469360-.|tc-/*BG&f&uzxG|NG4Dnts#C4L$j2,#,^:;fd99d62ad94fd0f261d7aaa09cce38030cs55e9a6192d683bd577f2717f7ce0088334e06fb4389d01529c73a372e6b3826c4c6116d4ZWf88a2521b69a3749ddf308D2fEDUIM="
  },
  // KV Namespace bindings.
  "kv_namespaces": [
    {
      "binding": "TEST",
      "id": "0b7e34627ddf4b6abd225faca9f10526",
      "preview_id": "dc6cdf4c9f594bb09f7c0e956a20e469"
    },
    {
      "binding": "CAP",
      "id": "dd7dbe03955d4c7da8797c8148739227",
      "preview_id": "1a79d9a2fb91478c8db13e62495b69ba"
    }
  ],
  // Durable Object bindings.
  "durable_objects": {
    "bindings": [
      { "name": "THREAD_DO", "class_name": "Thread" },
      { "name": "BOARD_DO", "class_name": "Board" }
    ]
  },
  // R2 Bucket bindings.
  "r2_buckets": [
    {
      "binding": "ch3www",
      "bucket_name": "3ch"
    }
  ],
  // Static Assets。3chiko.html本体(src/3chiko.jsからenv.ASSETS.fetchで参照)を配信する。
  // Workerが全パスを処理するため run_worker_first は不要(デフォルトのパス一致配信と衝突しない)。
  // html_handling: "none" にしないと、env.ASSETS.fetch("/3chiko.html") 自体が既定の
  // 「.html を落として/3chikoへ307」正規化を受けてしまい本文を取得できない。
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "Thread",
        "Board"
      ]
    }
  ],
  // Limits for your Worker.
  "limits": {
    "cpu_ms": 300000
  }
}
