{
  "name": "3ch",
  "type": "module",
  "scripts": {
    "dev": "npm run v6:build && wrangler dev --config wrangler.jsonc",
    "deploy": "npm run v6:build && wrangler deploy --config wrangler.jsonc --minify",
    "pretest": "sbt bbs/Test/fastLinkJS bbsClient/fastLinkJS adminClient/fastLinkJS",
    "test": "node --test tests/*.test.js",
    "v6:generate": "sbt codegen/run",
    "v6:build:client": "vite build --mode client",
    "v6:build:server": "vite build --mode workers",
    "v6:build:admin": "vite build --config vite.admin.config.ts && node -e \"require('node:fs').accessSync('dist/admin/index.html')\"",
    "v6:build": "npm run v6:generate && npm run v6:build:client && npm run v6:build:server && npm run v6:build:admin",
    "v6:typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hono/vite-build": "1.11.1",
    "@scala-js/vite-plugin-scalajs": "1.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.3",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "@hono/react-renderer": "1.0.1",
    "@noble/hashes": "2.4.0",
    "hono": "4.13.11",
    "honox": "^0.1.62",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@scala-js/vite-plugin-scalajs": {
      "vite": "$vite"
    }
  }
}
